# Leave unset to use the same-origin /multiplayer secure proxy.
# VITE_SDP_SERVER_URL=/multiplayer
# On Vercel, set this to the actual Render HTTPS/WSS origin and redeploy:
# VITE_SDP_SERVER_URL=https://your-backend.onrender.com
# Never put LiveKit API keys, secrets, or tokens in VITE_ variables.
# SDP_LAN_IP=192.168.1.20
# SDP_WEB_PORT=5173
# PORT=2567
# LIVEKIT_PORT=7880
# LIVEKIT_RTC_TCP_PORT=7881
# LIVEKIT_RTC_UDP_PORT=7882
VITE_VOICE_FULL_DISTANCE=3
VITE_VOICE_MAX_DISTANCE=15
