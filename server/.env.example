PORT=2567
HOST=0.0.0.0
# Further restrict shared/GameplayConfig.ts. False rejects all Shooter joins.
ENABLE_SHOOTER_TEST=true
# dev:lan generates real credentials for its own local LiveKit server.
# For a separately configured LiveKit instance, set these on the BACKEND ONLY:
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=http://127.0.0.1:7880
# LIVEKIT_PUBLIC_URL=/voice
# Online deployment: put these values in Render, not in frontend variables.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# LIVEKIT_URL=https://your-project.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-project-api-key
# LIVEKIT_API_SECRET=your-project-api-secret
# NODE_ENV=production
